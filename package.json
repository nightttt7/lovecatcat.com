{
  "name": "lovecatcat-blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build:assets": "node scripts/build-post-editor-preview.mjs",
    "dev": "npm run build:assets && tsx watch src/server.ts",
    "wrangler": "node scripts/wrangler.mjs",
    "deploy:preview": "npm run wrangler -- deploy --env preview && node scripts/preview-subdomain.mjs enable",
    "deploy:preview:inactive": "node scripts/preview-subdomain.mjs disable",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "better-sqlite3": "^12.8.0",
    "hono": "^4.13.7",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  }
}
